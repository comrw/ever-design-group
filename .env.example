# Copy to .env.local and fill in. NEXT_PUBLIC_* values are built into the
# page, so rebuild/redeploy after changing them. Leave a value empty to keep
# that feature in its honest "not configured" state.

# Film (section "From first line to final detail")
# Without a source the poster is shown with no play control.
NEXT_PUBLIC_FILM_SRC=
# Optional: MIME type of the film, e.g. video/mp4 or video/webm
NEXT_PUBLIC_FILM_TYPE=
# Optional: WebVTT captions file and its language code
NEXT_PUBLIC_FILM_CAPTIONS_SRC=
NEXT_PUBLIC_FILM_CAPTIONS_LANG=en

# Project enquiry form
# An endpoint that accepts a JSON POST: { name, email, location, project }
# and returns a 2xx status on success (e.g. a Formspree/Basin form URL).
# Without it, the form validates but tells the visitor nothing was sent.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
